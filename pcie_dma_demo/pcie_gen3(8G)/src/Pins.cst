IO_LOC "led[3]" R19;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[2]" U21;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" R17;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[0]" T18;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "pcie_rstn" W11;
IO_PORT "pcie_rstn" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "rst_n" AB13;
IO_PORT "rst_n" PULL_MODE=UP DRIVE=OFF  BANK_VCCIO=3.3;
IO_LOC "sys_clk_p" V22;
IO_PORT "sys_clk_p" PULL_MODE=UP DRIVE=OFF PULL_STRENGTH=STRONG BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// PCIe sideband note (Console 32001C, RPi 5 host)
//
// J4 pins 14/15 are cross-assigned compared with the Raspberry Pi PCIe
// connector standard: the host's CLKREQ# actually arrives on FPGA T14 and
// the host's WAKE# on FPGA AA14 (the board net names are the opposite).
// This demo does not use these signals, so nothing is constrained here.
// If your design does use them, bind by host function, not by net name:
//
//   IO_LOC "clkreq_n" T14;
//   IO_PORT "clkreq_n" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
//   IO_LOC "wake_n"  AA14;
//   IO_PORT "wake_n"  PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
//
// The same mapping applies to the Tang Mega 60K Console (AA14/T14).
// ---------------------------------------------------------------------------
